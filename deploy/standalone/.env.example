# Use the UID/GID of the Linux account that owns ./data and ./imports.
PUID=1000
PGID=1000

# Optional external 256-bit key (64 hex characters). Leave empty to create
# and use ./data/secrets.key automatically. Keep a configured key outside backups.
KASSENSTURZ_MASTER_KEY=

# Optional reverse-proxy trust configuration. Only list exact proxy IPs/CIDRs
# that overwrite X-Forwarded-Proto and append X-Forwarded-For safely.
# Leave empty unless a reverse proxy is deliberately configured.
KASSENSTURZ_TRUSTED_PROXIES=

# Optional private networks allowed to reach future mobile API routes (CIDR list).
# Empty by default. This setting does not publish a port or enable the mobile API.
KASSENSTURZ_MOBILE_CLIENT_NETWORKS=

